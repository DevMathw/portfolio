# Access key de Web3Forms para el formulario de contacto.
# Es una clave pública (viaja al cliente), no un secreto: se expone aquí
# para poder rotarla sin tocar código. Si falta, Contact.jsx usa un
# fallback interno y el formulario sigue funcionando.
# Consíguela gratis en https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=your_access_key_here
